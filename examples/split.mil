split:
    $string <string
    $strbuf "" <strbuf $bool
    >string $counter strlen #1 swap sub <counter

    splitCycle:
        >counter #0 cmp <bool
        
        >string >counter strat
        " " cmp @addString jz
        >string >counter strat
        >strbuf strjoin <strbuf

        #1 >counter sub <counter
        >bool
        @splitCycle jnz
        @splitEnd jmp

        addString:
            >strbuf "" <strbuf
            #1 >counter sub <counter
            @splitCycle jmp
        splitEnd:
            >strbuf "" <strbuf
            swap
            ret